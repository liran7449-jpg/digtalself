# ===================================
# Digital Self - 环境变量配置
# ===================================

# -----------------------------------
# 数据库配置
# -----------------------------------

# PostgreSQL 数据库连接（生产环境）
# 示例：postgresql://user:password@host:5432/database
# 如果不设置，默认使用本地 SQLite
DATABASE_URL=

# SQLite 数据库路径（本地开发，默认）
DIGITAL_SELF_DB=./data/digital-self.db

# -----------------------------------
# 文件存储配置
# -----------------------------------

# 本地存储路径（默认）
DIGITAL_SELF_MEDIA_ROOT=./data/media

# Cloudflare R2 存储（生产环境）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=digital-self
R2_PUBLIC_URL=https://cdn.yourdomain.com

# -----------------------------------
# 认证配置
# -----------------------------------

# 密码哈希（必需）
# 生成方法：npm run auth:hash-password your-password
# ⚠️ 重要：bcrypt 哈希包含 $ 符号，在 .env 文件中必须用 \$ 转义！
# 示例：AUTH_PASSWORD_HASH=\$2b\$10\$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_PASSWORD_HASH=

# Session 加密密钥（必需，至少 32 字符）
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# -----------------------------------
# Next.js 配置
# -----------------------------------

# 运行环境
NODE_ENV=development

# 应用 URL（生产环境）
NEXT_PUBLIC_APP_URL=https://yourdomain.com
