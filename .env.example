# ===================================
# Digital Self - 环境变量配置
# ===================================

# -----------------------------------
# 数据库配置
# -----------------------------------

# PostgreSQL 数据库连接（必需）
# 本地开发：postgresql://postgres:localdev123@localhost:5432/digitalself
# 生产环境：postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://postgres:localdev123@localhost:5432/digitalself

# -----------------------------------
# 文件存储配置
# -----------------------------------

# 本地存储路径（默认）
DIGITAL_SELF_MEDIA_ROOT=./data/media

# Cloudflare R2 存储（生产环境）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=digital-self
R2_PUBLIC_URL=https://cdn.yourdomain.com

# -----------------------------------
# 认证配置
# -----------------------------------

# 密码哈希（必需）
# 生成方法：npm run auth:hash-password your-password
# ⚠️ 重要：bcrypt 哈希包含 $ 符号，在 .env 文件中必须用 \$ 转义！
# 示例：AUTH_PASSWORD_HASH=\$2b\$10\$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_PASSWORD_HASH=

# Session 加密密钥（必需，至少 32 字符）
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# -----------------------------------
# Next.js 配置
# -----------------------------------

# 运行环境
NODE_ENV=development

# 应用 URL（生产环境）
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# -----------------------------------
# 时区（必需）
# -----------------------------------

# 服务端时间计算基准。不设置的话云平台默认 UTC，
# 会导致问候语（Good morning/afternoon）和日期切换错误。
TZ=Asia/Shanghai
